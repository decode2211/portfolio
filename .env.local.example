# -------------------------------------------------------
# Admin Portal Credentials
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# -------------------------------------------------------

# Username for the admin login page (/admin/login)
NEXT_PUBLIC_ADMIN_USERNAME=your_username_here

# Password for the admin login page
NEXT_PUBLIC_ADMIN_PASSWORD=your_password_here

# -------------------------------------------------------
# NextAuth (add when integrating next-auth later)
# -------------------------------------------------------

# A random secret string used to sign session tokens
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# The full URL of your deployed site (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
